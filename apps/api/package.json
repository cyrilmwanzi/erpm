{
  "name": "@scace/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/payments/mpesa.spec.js dist/expiry/expiry-reporting.spec.js dist/billing/billing.spec.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@better-auth/prisma-adapter": "^1.7.27",
    "@better-auth/redis-storage": "^1.7.27",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-fastify": "^12.6.0",
    "@scace/db": "workspace:*",
    "@sentry/nestjs": "^11.17.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.27",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "posthog-node": "^6.0.6",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.39.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@scace/typescript-config": "workspace:*",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
