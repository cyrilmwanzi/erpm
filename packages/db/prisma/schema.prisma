enum ExpiryEnforcementMode {
  BLOCK_EXPIRED
  WARN_ONLY
}

enum ExpiryAlertSeverity {
  WARNING
  CRITICAL
  EXPIRED
}

enum ExpiryAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum ReportDomain {
  INVENTORY_EXPIRY
  SALES_MPESA
  PROCUREMENT_CLAIMS
  PRODUCTION_COSTING
}

enum ReportFormat {
  JSON
  CSV
  PDF
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum CommunicationEventType {
  STOCK_EXPIRY_WARNING
  STOCK_EXPIRY_CRITICAL
  STOCK_EXPIRED
  STOCK_AUTO_QUARANTINED
  STOCK_EXPIRY_WRITEOFF
  SCHEDULED_REPORT_READY
  ON_DEMAND_REPORT_DISPATCH
  INVOICE_ISSUED
  INVOICE_PAYMENT_RECEIVED
  CUSTOMER_PO_CONFIRMED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OutboxDeliveryStatus {
  PENDING
  PROCESSING
  DISPATCHED
  PARTIAL
  FAILED
  ACKNOWLEDGED
  CANCELLED
}

model StockExpiryPolicy {
  id                           String                @id @default(cuid())
  organizationId               String                @unique
  organization                 Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warningDays                  Int                   @default(30)
  criticalDays                 Int                   @default(7)
  enforcementMode              ExpiryEnforcementMode @default(BLOCK_EXPIRED)
  autoQuarantineExpired        Boolean               @default(false)
  autoQuarantineOnCriticalDays Int?
  scanIntervalMinutes          Int                   @default(60)
  isScannerActive              Boolean               @default(true)
  lastScannedAt                DateTime?
  lastScanSummary              Json?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt

  @@map("stock_expiry_policy")
}

model StockExpiryAlert {
  id                   String              @id @default(cuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLotId           String
  stockLot             StockLot            @relation(fields: [stockLotId], references: [id], onDelete: Cascade)
  itemId               String
  item                 Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId           String
  location             Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  severity             ExpiryAlertSeverity
  status               ExpiryAlertStatus   @default(OPEN)
  dedupeKey            String
  expiresAt            DateTime
  daysUntilExpiry      Int
  quantityAtRisk       Int
  valueAtRiskCents     Int
  outboxEventId        String?
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  resolvedAt           DateTime?
  resolvedByUserId     String?
  resolutionNotes      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, severity, expiresAt])
  @@index([organizationId, stockLotId])
  @@index([organizationId, itemId, locationId])
  @@map("stock_expiry_alert")
}

model StockExpiryWriteOff {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  writeOffNumber     String
