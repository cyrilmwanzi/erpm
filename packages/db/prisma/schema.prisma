  shortcodeType               MpesaShortcodeType @default(PAYBILL)
  businessShortCode           String             @default("174379")
  partyB                      String?
  consumerKeyEncrypted        String?
  consumerSecretEncrypted     String?
  passkeyEncrypted            String?
  callbackRouteTokenHash      String             @unique
  callbackRouteTokenEncrypted String
  callbackIpAllowlist         String[]           @default([])
  accountReferencePrefix      String?            @default("SCACE")
  transactionDescTemplate     String?            @default("Scace Subscription")
  lastTestedAt                DateTime?
  lastTestStatus              String?
  updatedByUserId             String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  @@map("platform_mpesa_config")
}

model BillingPlan {
  id                String                     @id @default(cuid())
  code              String                     @unique
  name              String
  description       String?
  isActive          Boolean                    @default(true)
  isPublic          Boolean                    @default(true)
  isDefaultTrial    Boolean                    @default(false)
  sortOrder         Int                        @default(0)
  currency          String                     @default("KES")
  monthlyPriceCents Int                        @default(0)
  annualPriceCents  Int                        @default(0)
  trialDays         Int                        @default(14)
  gracePeriodDays   Int                        @default(7)
  maxMembers        Int?
  maxLocations      Int?
  maxItems          Int?
  maxMonthlyOrders  Int?
  maxStorageBytes   BigInt?
  features          Json                       @default("{}")
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  subscriptions     OrganizationSubscription[]
  invoices          BillingInvoice[]

  @@index([isActive, isPublic, sortOrder])
  @@map("billing_plan")
}

model OrganizationSubscription {
  id                    String                    @id @default(cuid())
  organizationId        String                    @unique
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId                String
  plan                  BillingPlan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingCycle          SubscriptionBillingCycle              @default(MONTHLY)
  status                BillingSubscriptionStatus @default(TRIALING)
  trialStartsAt         DateTime?
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  gracePeriodEndsAt     DateTime?
  cancelAtPeriodEnd     Boolean                   @default(false)
  canceledAt            DateTime?
  suspendedAt           DateTime?
  suspensionReason      String?
  lockedAt              DateTime?
  lastEnforcedStatus    BillingSubscriptionStatus?
  lastStatusEvaluatedAt DateTime?
  lastPaymentAt         DateTime?
  metadata              Json?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([status, gracePeriodEndsAt])
  @@index([planId])
  @@map("organization_subscription")
}

model OrganizationBillingOverride {
  id                       String                     @id @default(cuid())
  organizationId           String                     @unique
  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive                 Boolean                    @default(true)
  exemptFromBilling        Boolean                    @default(false)
  exemptUntil              DateTime?
  forceStatus              BillingSubscriptionStatus?
  forcePlanId              String?
  customTrialEndsAt        DateTime?
  customGracePeriodEndsAt  DateTime?
  customMaxMembers         Int?
  customMaxLocations       Int?
  customMaxItems           Int?
  customMaxMonthlyOrders   Int?
  customMaxStorageBytes    BigInt?
  discountPercent          Int?
  allowMpesaOverride       Boolean?
  featureOverrides         Json?
  reason                   String?
  notes                    String?
  createdByUserId          String?
  updatedByUserId          String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@map("organization_billing_override")
}

model BillingInvoice {
  id                  String                      @id @default(cuid())
  invoiceNumber       String                      @unique
  organizationId      String
  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId              String
  plan                BillingPlan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingCycle        SubscriptionBillingCycle
  currency            String
  subtotalCents       Int
  discountCents       Int                         @default(0)
  taxCents            Int                         @default(0)
  totalCents          Int
  amountPaidCents     Int                         @default(0)
  status              BillingInvoiceStatus        @default(OPEN)
  periodStart         DateTime
  periodEnd           DateTime
  dueAt               DateTime
  paidAt              DateTime?
  waivedAt            DateTime?
  waivedByUserId      String?
  waivedReason        String?
  notes               String?
  createdByUserId     String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  paymentTransactions BillingPaymentTransaction[]

  @@index([organizationId, status, createdAt])
  @@map("billing_invoice")
}

model BillingPaymentTransaction {
  id                 String               @id @default(cuid())
  referenceNumber    String               @unique
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId          String
  invoice            BillingInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method             BillingPaymentMethod @default(MPESA)
  status             BillingPaymentStatus @default(PENDING)
  currency           String
  amountCents        Int
  phoneNumber        String?
  accountReference   String?
  callbackToken      String?              @unique
  merchantRequestId  String?
  checkoutRequestId  String?              @unique
  mpesaReceiptNumber String?              @unique
  resultCode         String?
  resultDesc         String?
  initiatedByUserId  String?
  processedAt        DateTime?
  rawCallbackPayload Json?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([invoiceId, status])
  @@map("billing_payment_transaction")
}

model PlatformBillingAuditLog {
  id             String        @id @default(cuid())
  actorUserId    String?
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("platform_billing_audit_log")
}



