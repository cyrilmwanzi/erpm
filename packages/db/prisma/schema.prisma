  item               Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId         String
  location           Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  stockMovementId    String?
  quantity           Int
  unitCostCents      Int
  totalLossCents     Int
  reason             String
  disposalMethod     String?
  notes              String?
  writtenOffByUserId String?
  writtenOffAt       DateTime       @default(now())
  createdAt          DateTime       @default(now())

  @@unique([organizationId, writeOffNumber])
  @@index([organizationId, writtenOffAt])
  @@index([organizationId, itemId, locationId])
  @@map("stock_expiry_write_off")
}

model ReportSchedule {
  id              String                 @id @default(cuid())
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  domain          ReportDomain
  format          ReportFormat           @default(PDF)
  frequency       ReportFrequency        @default(WEEKLY)
  cronHourUtc     Int                    @default(6)
  dayOfWeek       Int?
  dayOfMonth      Int?
  filters         Json?
  recipientEmails String[]               @default([])
  channelHints    CommunicationChannel[] @default([EMAIL])
  isActive        Boolean                @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  runs            ReportRun[]

  @@index([organizationId, isActive, nextRunAt])
  @@index([isActive, nextRunAt])
  @@map("report_schedule")
}

model ReportRun {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleId        String?
  schedule          ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  domain            ReportDomain
  format            ReportFormat
  status            ReportRunStatus @default(COMPLETED)
  filters           Json?
  summaryKpis       Json?
  rowCount          Int             @default(0)
  storedObjectId    String?
  outboxEventId     String?
  durationMs        Int             @default(0)
  errorMessage      String?
  triggeredByUserId String?
  startedAt         DateTime        @default(now())
  completedAt       DateTime?
  createdAt         DateTime        @default(now())

  @@index([organizationId, domain, createdAt])
  @@index([organizationId, scheduleId, createdAt])
  @@map("report_run")
}

model AlertRule {
  id              String                 @id @default(cuid())
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  eventType       CommunicationEventType
  isActive        Boolean                @default(true)
  channels        CommunicationChannel[] @default([EMAIL])
