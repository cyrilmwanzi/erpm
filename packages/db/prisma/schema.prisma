generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Better Auth Core & Organization Models
// ==========================================

enum PlatformRole {
  USER
  SYSTEM_ADMIN
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  platformRole  PlatformRole @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members                 Member[]
  invitations             Invitation[]
  personalAccessTokens    PersonalAccessToken[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthRefreshTokens      OAuthRefreshToken[]
  registeredDevices       RegisteredDevice[]
  platformBillingAudits   PlatformBillingAuditLog[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id             String          @id
  name           String
  slug           String          @unique
  logo           String?
  createdAt      DateTime        @default(now())
  metadata       String?
  members        Member[]
  invitations          Invitation[]
  organizationSettings OrganizationSettings?
  auditLogs            AuditLog[]
  items              Item[]
  itemRevisions      ItemRevision[]
  locations          Location[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  stockTransfers     StockTransfer[]
  stockTransferLines StockTransferLine[]
  suppliers          Supplier[]
  supplierItems      SupplierItem[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]
  goodsReceiptLines  GoodsReceiptLine[]
  vendorBills        VendorBill[]
  vendorBillLines    VendorBillLine[]
  storedObjects      StoredObject[]
  departments        Department[]
  workSchedules      WorkSchedule[]
  staffProfiles      StaffProfile[]
  holidays           Holiday[]
  timeOffRequests    TimeOffRequest[]
  teams              Team[]
  teamMembers        TeamMember[]
  calendarFeeds      CalendarFeed[]
  crmConnection         CrmConnection?
  crmStaffMappings      CrmStaffMapping[]
  crmDealItemLinks      CrmDealItemLink[]
  crmWebhookEvents      CrmWebhookEvent[]
  itemPacks             ItemPack[]
  itemBundleComponents  ItemBundleComponent[]
  servicePlans          ServicePlan[]
  priceBooks            PriceBook[]
  priceRules            PriceRule[]
  priceTiers            PriceTier[]
  discountRules         DiscountRule[]
  stockLots             StockLot[]
  quarantineHolds       QuarantineHold[]
  supplierClaims        SupplierClaim[]
  customerPurchaseOrders     CustomerPurchaseOrder[]
  customerPurchaseOrderLines CustomerPurchaseOrderLine[]
  customers             Customer[]
  orders                Order[]
  orderLines            OrderLine[]
  salesInvoices         SalesInvoice[]
  salesInvoiceLines     SalesInvoiceLine[]
  customerPayments      CustomerPayment[]
  paymentReceipts       PaymentReceipt[]
  fulfillmentSettings   FulfillmentSettings?
  orderFulfillments     OrderFulfillment[]
  staffJobs             StaffJob[]
  notificationTemplates   NotificationTemplate[]
  customerNotifications   CustomerNotification[]
  oauthClients            OAuthClient[]
  oauthClientKeys         OAuthClientKey[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthDeviceCodes        OAuthDeviceCode[]
  oauthRefreshTokens      OAuthRefreshToken[]
  personalAccessTokens    PersonalAccessToken[]
  registeredDevices       RegisteredDevice[]
  ssoProviders            OrganizationSsoProvider[]
  documentAttachments     DocumentAttachment[]
  workCenters             WorkCenter[]
  billsOfMaterial         BillOfMaterial[]
  routings                Routing[]
  productionBatches       ProductionBatch[]
  productionOperations    ProductionOperation[]
  productionTimeLogs      ProductionTimeLog[]
  productionQcCheckpoints ProductionQcCheckpoint[]
  productionCostEntries   ProductionCostEntry[]
  productionConsumptions  ProductionConsumption[]
  productionReservations  ProductionMaterialReservation[]
  mpesaConfiguration        MpesaConfiguration?
  paymentTransactions       PaymentTransaction[]
  variantOptions            VariantOption[]
  variantOptionValues       VariantOptionValue[]
  itemTemplateOptions       ItemTemplateOption[]
  itemTemplateOptionValues  ItemTemplateOptionValue[]
  itemVariantAttributes     ItemVariantAttribute[]
  stockExpiryPolicy         StockExpiryPolicy?
  stockExpiryAlerts         StockExpiryAlert[]
  stockExpiryWriteOffs      StockExpiryWriteOff[]
  reportSchedules           ReportSchedule[]
  reportRuns                ReportRun[]
  alertRules                AlertRule[]
  communicationWebhooks     CommunicationWebhook[]
  communicationOutboxEvents CommunicationOutboxEvent[]
  communicationDeliveryAttempts CommunicationDeliveryAttempt[]
  subscription                  OrganizationSubscription?
  billingOverride               OrganizationBillingOverride?
  billingInvoices               BillingInvoice[]
  billingPaymentTransactions    BillingPaymentTransaction[]
  platformBillingAudits         PlatformBillingAuditLog[]

  @@map("organization")
}

model Member {
  id             String        @id
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String        @default("member")
  createdAt      DateTime      @default(now())
  staffProfile   StaffProfile?

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ==========================================
// Multi-Organization ERP Base Scaffold Models
// ==========================================

model OrganizationSettings {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyLegalName     String?
  defaultCurrency      String       @default("USD")
  timezone             String       @default("UTC")
  fiscalYearStartMonth Int          @default(1)
  storageBucket        String?      @unique
  storageQuotaBytes    BigInt       @default(1073741824)
  features             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("tenant_settings")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

// ==========================================
// Items & Services Catalog Models
// ==========================================

enum ItemType {
  SELLABLE
  MERCH
  RAW_MATERIAL
  SERVICE
  CONSUMABLE
}

enum ItemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ItemRevisionAction {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
}

enum ItemVariantKind {
  STANDARD
  TEMPLATE
  VARIANT
}

enum VariantOptionDisplayType {
  SELECT
  COLOR
  SIZE
  TEXT
}

model Item {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku                String
  name               String
  description        String?
  type               ItemType
  status             ItemStatus     @default(ACTIVE)
  unitOfMeasure      String         @default("unit")
  currency           String         @default("USD")
  salePriceCents     Int            @default(0)
  costPriceCents     Int            @default(0)
  trackInventory        Boolean             @default(true)
  allowNegativeStock    Boolean             @default(false)
  reorderPoint          Int?
  trackExpiry           Boolean             @default(false)
  shelfLifeDays         Int?
  expiryWarningDays     Int?
  expiryCriticalDays    Int?
  lotAllocationStrategy LotAllocationStrategy @default(FEFO)
  isBundle              Boolean             @default(false)
  variantKind        ItemVariantKind     @default(STANDARD)
  parentItemId       String?
  parentItem         Item?               @relation("ItemVariantHierarchy", fields: [parentItemId], references: [id], onDelete: Restrict)
  variants           Item[]              @relation("ItemVariantHierarchy")
  variantKey         String?
  inheritParentPricing Boolean           @default(true)
  salePriceOverrideCents Int?
  costPriceOverrideCents Int?
  tags               String[]            @default([])
  metadata           Json?
  version            Int                 @default(1)
  createdByUserId    String?
  updatedByUserId    String?
  archivedAt         DateTime?
  archivedByUserId   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  templateOptions    ItemTemplateOption[]    @relation("TemplateItemOptions")
  variantAttributes  ItemVariantAttribute[]  @relation("VariantItemAttributes")
  revisions          ItemRevision[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  stockTransferLines StockTransferLine[]
  supplierItems      SupplierItem[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  vendorBillLines    VendorBillLine[]
  crmDealLinks       CrmDealItemLink[]
  packs              ItemPack[]
  bundleComponents   ItemBundleComponent[] @relation("BundleParentItem")
  includedInBundles  ItemBundleComponent[] @relation("BundleComponentItem")
  servicePlans       ServicePlan[]
  priceRules         PriceRule[]
  discountRules      DiscountRule[]
  stockLots          StockLot[]
  quarantineHolds    QuarantineHold[]
  supplierClaims     SupplierClaim[]
  customerPurchaseOrderLines  CustomerPurchaseOrderLine[]
  orderLines                  OrderLine[]
  salesInvoiceLines           SalesInvoiceLine[]
  billsOfMaterialAsFinished   BillOfMaterial[]                @relation("FinishedItemBoms")
  bomLinesAsComponent         BomLine[]                       @relation("ComponentItemBomLines")
  routings                    Routing[]
  productionBatchesAsFinished ProductionBatch[]               @relation("BatchFinishedItem")
  materialReservationsAsItem  ProductionMaterialReservation[] @relation("ReservationItem")
  productionConsumptions      ProductionConsumption[]         @relation("ConsumptionItem")
  stockExpiryAlerts           StockExpiryAlert[]
  stockExpiryWriteOffs        StockExpiryWriteOff[]

  @@unique([organizationId, sku])
  @@unique([organizationId, parentItemId, variantKey])
  @@index([organizationId, status, type])
  @@index([organizationId, variantKind, status])
  @@index([organizationId, parentItemId])
  @@index([organizationId, updatedAt])
  @@map("item")
}

model ItemRevision {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  version        Int
  action         ItemRevisionAction
  changes        Json
  reason         String?
  actorUserId    String?
  createdAt      DateTime           @default(now())

  @@unique([itemId, version])
  @@index([organizationId, itemId, version])
  @@map("item_revision")
}

// ==========================================
// Multi-Location & Inventory Models
// ==========================================

enum LocationType {
  WAREHOUSE
  RETAIL_STORE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockMovementType {
  RECEIPT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  SALE_RETURN
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  EXPIRY_WRITEOFF
}

enum LotAllocationStrategy {
  FEFO
  FIFO
  MANUAL
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model Location {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  name              String
  type              LocationType
  status            LocationStatus  @default(ACTIVE)
  isDefault         Boolean         @default(false)
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  timezone          String?
  phone             String?
  email             String?
  metadata          Json?
  createdByUserId   String?
  updatedByUserId   String?
  archivedAt        DateTime?
  archivedByUserId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  outgoingTransfers StockTransfer[] @relation("TransferFromLocation")
  incomingTransfers StockTransfer[] @relation("TransferToLocation")
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  staffProfiles     StaffProfile[]
  holidays          Holiday[]
  stockLots         StockLot[]
  quarantineHolds   QuarantineHold[]
  orders            Order[]
  orderFulfillments OrderFulfillment[]
  oauthClients      OAuthClient[]
  oauthDeviceCodes  OAuthDeviceCode[]
  registeredDevices      RegisteredDevice[]
  workCenters            WorkCenter[]
  productionBatches      ProductionBatch[]
  productionReservations ProductionMaterialReservation[]
  productionConsumptions ProductionConsumption[]
  stockExpiryAlerts      StockExpiryAlert[]
  stockExpiryWriteOffs   StockExpiryWriteOff[]

  @@unique([organizationId, code])
  @@index([organizationId, status, type])
  @@map("location")
}

model StockBalance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHandQty      Int          @default(0)
  reservedQty    Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, itemId, locationId])
  @@index([organizationId, locationId])
  @@index([organizationId, itemId])
  @@map("stock_balance")
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type           StockMovementType
  quantityDelta  Int
  balanceAfter   Int
  stockLotId     String?
  stockLot       StockLot?         @relation(fields: [stockLotId], references: [id], onDelete: SetNull)
  referenceType  String?
  referenceId    String?
  reason         String?
  actorUserId    String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, itemId, locationId, createdAt])
  @@index([organizationId, stockLotId])
  @@index([organizationId, createdAt])
  @@map("stock_movement")
}

model StockTransfer {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transferNumber     String
  fromLocationId     String
  fromLocation       Location            @relation("TransferFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId       String
  toLocation         Location            @relation("TransferToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  status             StockTransferStatus @default(DRAFT)
  notes              String?
  createdByUserId    String?
  dispatchedByUserId String?
  dispatchedAt       DateTime?
  receivedByUserId   String?
  receivedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lines              StockTransferLine[]

  @@unique([organizationId, transferNumber])
  @@index([organizationId, status])
  @@map("stock_transfer")
}

model StockTransferLine {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity        Int
  createdAt       DateTime      @default(now())

  @@unique([stockTransferId, itemId])
  @@index([organizationId, stockTransferId])
  @@map("stock_transfer_line")
}

// ==========================================
// Supplier & Procurement Models
// ==========================================

enum SupplierStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum VendorBillStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum GoodsReceiptStatus {
  PENDING_QC
  QC_IN_PROGRESS
  QC_COMPLETED
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  CANCELLED
}

enum DeliveryLineQcStatus {
  PENDING
  PASSED
  PARTIAL
  FAILED
  QUARANTINED
}

enum RejectionDisposition {
  REOPEN_PO
  SUPPLIER_CLAIM
  QUARANTINE
  SCRAP
}

enum QuarantineStatus {
  OPEN
  RELEASED_TO_STOCK
  RETURNED_TO_SUPPLIER
  CLAIMED
  SCRAPPED
}

enum SupplierClaimType {
  CREDIT
  REPLACEMENT
  RETURN
}

enum SupplierClaimStatus {
  OPEN
  SUBMITTED
  CREDITED
  REPLACED
  CLOSED
}

model Supplier {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  name             String
  status           SupplierStatus  @default(ACTIVE)
  email            String?
  phone            String?
  website          String?
  taxId            String?
  paymentTermsDays Int             @default(30)
  currency         String          @default("USD")
  leadTimeDays     Int             @default(7)
  addressLine1     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  notes            String?
  metadata         Json?
  createdByUserId  String?
  updatedByUserId  String?
  archivedAt       DateTime?
  archivedByUserId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  supplierItems    SupplierItem[]
  purchaseOrders   PurchaseOrder[]
  vendorBills      VendorBill[]
  priceBooks       PriceBook[]
  supplierClaims   SupplierClaim[]
  stockLots        StockLot[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("supplier")
}

model SupplierItem {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  packId            String?
  pack              ItemPack?          @relation(fields: [packId], references: [id], onDelete: SetNull)
  supplierSku       String?
  unitCostCents     Int
  currency          String             @default("USD")
  minOrderQty       Int                @default(1)
  leadTimeDays      Int?
  isPreferred       Boolean            @default(false)
  isActive          Boolean            @default(true)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  goodsReceiptLines GoodsReceiptLine[]
  stockLots         StockLot[]

  @@unique([organizationId, supplierId, itemId])
  @@index([organizationId, itemId])
  @@index([organizationId, supplierId])
  @@map("supplier_item")
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poNumber          String
  supplierId        String
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  locationId        String
  location          Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status            PurchaseOrderStatus @default(DRAFT)
  currency          String              @default("USD")
  subtotalCents     Int                 @default(0)
  taxCents          Int                 @default(0)
  totalCents        Int                 @default(0)
  notes             String?
  expectedAt        DateTime?
  submittedAt       DateTime?
  submittedByUserId String?
  cancelledAt       DateTime?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lines             PurchaseOrderLine[]
  goodsReceipts     GoodsReceipt[]
  vendorBills       VendorBill[]
  supplierClaims    SupplierClaim[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, supplierId, status])
  @@index([organizationId, locationId])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrderId      String
  purchaseOrder        PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId               String
  item                 Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  packId               String?
  pack                 ItemPack?          @relation(fields: [packId], references: [id], onDelete: SetNull)
  unitsPerPack         Int                @default(1)
  orderedBaseQty       Int                @default(0)
  receivedBaseQty      Int                @default(0)
  acceptedBaseQty      Int                @default(0)
  rejectedBaseQty      Int                @default(0)
  quarantinedBaseQty   Int                @default(0)
  creditedClaimBaseQty Int                @default(0)
  billedBaseQty        Int                @default(0)
  supplierSku          String?
  description          String?
  orderedQty           Int
  receivedQty          Int                @default(0)
  unitCostCents        Int
  lineTotalCents       Int
  pricingSnapshot      Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  receiptLines         GoodsReceiptLine[]

  @@index([organizationId, purchaseOrderId])
  @@map("purchase_order_line")
}

model GoodsReceipt {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptNumber     String
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  locationId        String
  location          Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status            GoodsReceiptStatus @default(PENDING_QC)
  carrier           String?
  trackingNumber    String?
  packingSlipNumber String?
  notes             String?
  receivedByUserId  String?
  receivedAt        DateTime           @default(now())
  deliveredAt       DateTime           @default(now())
  qcStartedAt       DateTime?
  qcCompletedAt     DateTime?
  qcByUserId        String?
  qcNotes           String?
  acceptedAt        DateTime?
  acceptedByUserId  String?
  acceptanceNotes   String?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lines               GoodsReceiptLine[]
  vendorBills         VendorBill[]
  quarantineHolds     QuarantineHold[]
  supplierClaims      SupplierClaim[]
  documentAttachments DocumentAttachment[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, locationId])
  @@index([organizationId, status])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id                   String                @id @default(cuid())
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceiptId       String
  goodsReceipt         GoodsReceipt          @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId  String
  purchaseOrderLine    PurchaseOrderLine     @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  itemId               String
  item                 Item                  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  packId               String?
  pack                 ItemPack?             @relation(fields: [packId], references: [id], onDelete: SetNull)
  supplierItemId       String?
  supplierItem         SupplierItem?         @relation(fields: [supplierItemId], references: [id], onDelete: SetNull)
  supplierBatchNumber  String?
  unitsPerPack         Int                   @default(1)
  packQty              Int                   @default(0)
  looseBaseQty         Int                   @default(0)
  receivedQty          Int
  receivedBaseQty      Int                   @default(0)
  unitCostCents        Int
  lotNumber            String?
  batchCode            String?
  manufacturedAt       DateTime?
  expiresAt            DateTime?
  serialNumbers        Json?
  qcStatus             DeliveryLineQcStatus  @default(PENDING)
  acceptedBaseQty      Int                   @default(0)
  rejectedBaseQty      Int                   @default(0)
  quarantinedBaseQty   Int                   @default(0)
  rejectionDisposition RejectionDisposition?
  defectReasonCode     String?
  qcNotes              String?
  qcInspectedByUserId  String?
  qcInspectedAt        DateTime?
  billedBaseQty        Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  stockLots            StockLot[]
  quarantineHolds      QuarantineHold[]
  supplierClaims       SupplierClaim[]
  vendorBillLines      VendorBillLine[]
  documentAttachments  DocumentAttachment[]

  @@index([organizationId, goodsReceiptId])
  @@index([organizationId, purchaseOrderLineId])
  @@index([organizationId, supplierItemId])
  @@map("goods_receipt_line")
}

model StockLot {
  id                     String                          @id @default(cuid())
  organizationId         String
  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId                 String
  item                   Item                            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId             String
  location               Location                        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  goodsReceiptLineId     String?
  goodsReceiptLine       GoodsReceiptLine?               @relation(fields: [goodsReceiptLineId], references: [id], onDelete: SetNull)
  supplierId             String?
  supplier               Supplier?                       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierItemId         String?
  supplierItem           SupplierItem?                   @relation(fields: [supplierItemId], references: [id], onDelete: SetNull)
  supplierSku            String?
  supplierBatchNumber    String?
  lotNumber              String
  batchCode              String?
  manufacturedAt         DateTime?
  expiresAt              DateTime?
  serialNumbers          Json?
  onHandQty              Int                             @default(0)
  quarantinedQty         Int                             @default(0)
  initialQty             Decimal                         @default(0) @db.Decimal(18, 4)
  consumedQty            Decimal                         @default(0) @db.Decimal(18, 4)
  unitCostCents          Int                             @default(0)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  quarantineHolds        QuarantineHold[]
  documentAttachments    DocumentAttachment[]
  productionConsumptions ProductionConsumption[]
  productionReservations ProductionMaterialReservation[]
  producedFromBatches    ProductionBatch[]               @relation("OutputStockLot")
  stockMovements         StockMovement[]
  expiryAlerts           StockExpiryAlert[]
  expiryWriteOffs        StockExpiryWriteOff[]

  @@index([organizationId, itemId, locationId])
  @@index([organizationId, lotNumber])
  @@index([organizationId, expiresAt])
  @@index([organizationId, supplierId])
  @@index([organizationId, supplierItemId])
  @@map("stock_lot")
}

model QuarantineHold {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceiptId     String
  goodsReceipt       GoodsReceipt     @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goodsReceiptLineId String
  goodsReceiptLine   GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Cascade)
  itemId             String
  item               Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId         String
  location           Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  stockLotId         String?
  stockLot           StockLot?        @relation(fields: [stockLotId], references: [id], onDelete: SetNull)
  quantityBase       Int
  resolvedBaseQty    Int              @default(0)
  status             QuarantineStatus @default(OPEN)
  reasonCode         String?
  notes              String?
  resolutionNotes    String?
  resolvedByUserId   String?
  resolvedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, goodsReceiptId])
  @@index([organizationId, itemId])
  @@map("quarantine_hold")
}

model SupplierClaim {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimNumber        String
  supplierId         String
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId    String
  purchaseOrder      PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  goodsReceiptId     String?
  goodsReceipt       GoodsReceipt?       @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  goodsReceiptLineId String?
  goodsReceiptLine   GoodsReceiptLine?   @relation(fields: [goodsReceiptLineId], references: [id], onDelete: SetNull)
  itemId             String
  item               Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  claimType          SupplierClaimType   @default(CREDIT)
  status             SupplierClaimStatus @default(OPEN)
  rejectedBaseQty    Int
  claimAmountCents   Int
  currency           String              @default("USD")
  reasonCode         String?
  notes              String?
  resolutionNotes    String?
  createdByUserId    String?
  resolvedByUserId   String?
  resolvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, claimNumber])
  @@index([organizationId, supplierId, status])
  @@index([organizationId, purchaseOrderId])
  @@map("supplier_claim")
}

model VendorBill {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billNumber      String
  supplierId      String
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceiptId  String?
  goodsReceipt    GoodsReceipt?    @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  status          VendorBillStatus @default(DRAFT)
  currency        String           @default("USD")
  subtotalCents   Int              @default(0)
  taxCents        Int              @default(0)
  totalCents      Int              @default(0)
  paidAmountCents Int              @default(0)
  issuedAt        DateTime         @default(now())
  dueAt           DateTime?
  paidAt          DateTime?
  voidedAt        DateTime?
  notes           String?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lines           VendorBillLine[]

  @@unique([organizationId, supplierId, billNumber])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, purchaseOrderId])
  @@map("vendor_bill")
}

model VendorBillLine {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorBillId       String
  vendorBill         VendorBill        @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  itemId             String?
  item               Item?             @relation(fields: [itemId], references: [id], onDelete: SetNull)
  goodsReceiptLineId String?
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id], onDelete: SetNull)
  description        String
  quantity           Int
  baseQty            Int               @default(0)
  unitCostCents      Int
  lineTotalCents     Int
  createdAt          DateTime          @default(now())

  @@index([organizationId, vendorBillId])
  @@index([organizationId, goodsReceiptLineId])
  @@map("vendor_bill_line")
}

// ==========================================
// Organization Object Storage (RustFS) Models
// ==========================================

enum StoredObjectStatus {
  PENDING
  READY
  DELETED
}

enum StorageEntityType {
  ORGANIZATION
  ITEM
  VENDOR_BILL
  PURCHASE_ORDER
  GOODS_RECEIPT
  GOODS_RECEIPT_LINE
  STOCK_LOT
  PRODUCTION_BATCH
  PRODUCTION_OPERATION
  PRODUCTION_QC_CHECKPOINT
  SUPPLIER
  CUSTOMER
  ORDER
  SALES_INVOICE
  PAYMENT_RECEIPT
  REPORT_RUN
}

enum AttachmentDocumentType {
  PACKING_SLIP
  BILL_OF_LADING
  COA
  QC_PHOTO
  INSPECTION_REPORT
  SUPPLIER_INVOICE
  SAFETY_DATA_SHEET
  OTHER
}

model StoredObject {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bucket              String
  objectKey           String
  originalName        String
  mimeType            String
  sizeBytes           BigInt               @default(0)
  etag                String?
  status              StoredObjectStatus   @default(PENDING)
  entityType          StorageEntityType    @default(ORGANIZATION)
  entityId            String?
  uploadedByUserId    String?
  tags                String[]             @default([])
  metadata            Json?
  completedAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  documentAttachments DocumentAttachment[]

  @@unique([organizationId, bucket, objectKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("stored_object")
}

model DocumentAttachment {
  id                       String                  @id @default(cuid())
  organizationId           String
  organization             Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storedObjectId           String
  storedObject             StoredObject            @relation(fields: [storedObjectId], references: [id], onDelete: Cascade)
  documentType             AttachmentDocumentType  @default(OTHER)
  caption                  String?
  goodsReceiptId           String?
  goodsReceipt             GoodsReceipt?           @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goodsReceiptLineId       String?
  goodsReceiptLine         GoodsReceiptLine?       @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Cascade)
  stockLotId               String?
  stockLot                 StockLot?               @relation(fields: [stockLotId], references: [id], onDelete: Cascade)
  productionBatchId        String?
  productionBatch          ProductionBatch?        @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  productionOperationId    String?
  productionOperation      ProductionOperation?    @relation(fields: [productionOperationId], references: [id], onDelete: Cascade)
  productionQcCheckpointId String?
  productionQcCheckpoint   ProductionQcCheckpoint? @relation(fields: [productionQcCheckpointId], references: [id], onDelete: Cascade)
  uploadedByUserId         String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([organizationId, goodsReceiptId])
  @@index([organizationId, goodsReceiptLineId])
  @@index([organizationId, stockLotId])
  @@index([organizationId, productionBatchId])
  @@index([organizationId, productionOperationId])
  @@index([organizationId, productionQcCheckpointId])
  @@index([organizationId, storedObjectId])
  @@map("document_attachment")
}

// ==========================================
// Staff Management, Teams & Calendar Models
// ==========================================

enum DepartmentStatus {
  ACTIVE
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum StaffStatus {
  PREBOARDING
  ACTIVE
  ON_LEAVE
  OFFBOARDED
}

enum LeaveType {
  VACATION
  SICK
  PERSONAL
  PARENTAL
  UNPAID
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TeamKind {
  PROJECT
  RESOURCE_POOL
  DEPARTMENT
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum CalendarFeedScope {
  STAFF
  TEAM
  ORGANIZATION
}

model Department {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  code               String
  description        String?
  parentDepartmentId String?
  parentDepartment   Department?      @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[]     @relation("DepartmentHierarchy")
  leadStaffId        String?
  leadStaff          StaffProfile?    @relation("DepartmentLead", fields: [leadStaffId], references: [id], onDelete: SetNull)
  status             DepartmentStatus @default(ACTIVE)
  archivedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  staffMembers       StaffProfile[]   @relation("DepartmentStaff")
  teams              Team[]
  staffJobs          StaffJob[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, parentDepartmentId])
  @@map("department")
}

model WorkSchedule {
  id                    String         @id @default(cuid())
  organizationId        String
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  timezone              String         @default("UTC")
  weeklyCapacityMinutes Int            @default(2400)
  workingDays           Json
  isDefault             Boolean        @default(false)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  staffProfiles         StaffProfile[]

  @@unique([organizationId, name])
  @@index([organizationId, isDefault, isActive])
  @@map("work_schedule")
}

model StaffProfile {
  id                    String           @id @default(cuid())
  organizationId        String
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId              String?          @unique
  member                Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  employeeCode          String?
  firstName             String
  lastName              String
  displayName           String
  workEmail             String
  phone                 String?
  jobTitle              String?
  departmentId          String?
  department            Department?      @relation("DepartmentStaff", fields: [departmentId], references: [id], onDelete: SetNull)
  managerStaffId        String?
  manager               StaffProfile?    @relation("StaffReporting", fields: [managerStaffId], references: [id], onDelete: SetNull)
  directReports         StaffProfile[]   @relation("StaffReporting")
  locationId            String?
  location              Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  workScheduleId        String?
  workSchedule          WorkSchedule?    @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  employmentType        EmploymentType   @default(FULL_TIME)
  status                StaffStatus      @default(ACTIVE)
  startDate             DateTime?
  endDate               DateTime?
  timezone              String           @default("UTC")
  weeklyCapacityMinutes Int              @default(2400)
  skills                String[]         @default([])
  bio                   String?
  metadata              Json?
  createdByUserId       String?
  updatedByUserId       String?
  offboardedAt          DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  ledDepartments        Department[]     @relation("DepartmentLead")
  ledTeams              Team[]           @relation("TeamLead")
  teamMemberships       TeamMember[]
  timeOffRequests       TimeOffRequest[] @relation("StaffTimeOff")
  reviewedTimeOff       TimeOffRequest[] @relation("TimeOffReviewer")
  calendarFeeds         CalendarFeed[]
  crmStaffMapping       CrmStaffMapping?
  courierFulfillments   OrderFulfillment[] @relation("FulfillmentCourier")
  assignedStaffJobs     StaffJob[]               @relation("StaffJobAssignee")
  productionTimeLogs    ProductionTimeLog[]      @relation("TimeLogStaff")
  assignedOperations    ProductionOperation[]    @relation("OperationAssignedStaff")
  signedOperations      ProductionOperation[]    @relation("OperationSignOffStaff")
  conductedCheckpoints  ProductionQcCheckpoint[] @relation("CheckpointConductedBy")
  approvedCheckpoints   ProductionQcCheckpoint[] @relation("CheckpointApprovedBy")

  @@unique([organizationId, workEmail])
  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, managerStaffId])
  @@map("staff_profile")
}

model Holiday {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  date              DateTime
  isRecurringAnnual Boolean      @default(false)
  isHalfDay         Boolean      @default(false)
  locationId        String?
  location          Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  notes             String?
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, date])
  @@index([organizationId, locationId])
  @@map("holiday")
}

model TimeOffRequest {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId           String
  staff             StaffProfile  @relation("StaffTimeOff", fields: [staffId], references: [id], onDelete: Cascade)
  leaveType         LeaveType
  startDate         DateTime
  endDate           DateTime
  totalMinutes      Int
  status            TimeOffStatus @default(PENDING)
  reason            String?
  reviewedByStaffId String?
  reviewedByStaff   StaffProfile? @relation("TimeOffReviewer", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNote        String?
  createdByUserId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId, staffId, status])
  @@index([organizationId, startDate, endDate])
  @@map("time_off_request")
}

model Team {
  id                   String         @id @default(cuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  description          String?
  kind                 TeamKind       @default(PROJECT)
  status               TeamStatus     @default(ACTIVE)
  departmentId         String?
  department           Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leadStaffId          String?
  leadStaff            StaffProfile?  @relation("TeamLead", fields: [leadStaffId], references: [id], onDelete: SetNull)
  defaultAllocationPct Int            @default(100)
  metadata             Json?
  archivedAt           DateTime?
  createdByUserId      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  members              TeamMember[]
  calendarFeeds        CalendarFeed[]
  staffJobs            StaffJob[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, kind])
  @@map("team")
}

model TeamMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staffId        String
  staff          StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  roleInTeam     String       @default("member")
  allocationPct  Int          @default(100)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, teamId, staffId])
  @@index([organizationId, staffId])
  @@map("team_member")
}

model CalendarFeed {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  scope           CalendarFeedScope
  staffId         String?
  staff           StaffProfile?     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tokenHash       String            @unique
  includeTimeOff  Boolean           @default(true)
  includeHolidays Boolean           @default(true)
  includeShifts   Boolean           @default(false)
  revokedAt       DateTime?
  lastAccessedAt  DateTime?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([organizationId, scope])
  @@index([organizationId, staffId])
  @@index([organizationId, teamId])
  @@map("calendar_feed")
}

// ==========================================
// CustomerMates CRM Integration Models
