// ==========================================

enum ServicePlanType {
  RETAINER
  HOUR_PACK
  SUBSCRIPTION
  MILESTONE
}

enum BillingCycle {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PriceBookDirection {
  SALES
  PURCHASE
}

enum PricingModel {
  FLAT
  VOLUME
  GRADUATED
  PACKAGE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
  BUY_X_GET_Y
}

enum DiscountScope {
  LINE_ITEM
  ORDER
}

model ItemPack {
  id                    String                @id @default(cuid())
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId                String
  item                  Item                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  unitOfMeasure         String
  unitsPerPack          Int                   @default(1)
  barcode               String?
  packSku               String?
  salePriceCents        Int?
  costPriceCents        Int?
  isSellable            Boolean               @default(true)
  isPurchasable         Boolean               @default(true)
  isDefaultSalesPack    Boolean               @default(false)
  isDefaultPurchasePack Boolean               @default(false)
  minOrderPacks         Int                   @default(1)
  packStep              Int                   @default(1)
  weightGrams           Int?
  dimensionsJson        Json?
  isActive              Boolean               @default(true)
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  bundleComponents      ItemBundleComponent[]
  priceRules            PriceRule[]
  discountRules         DiscountRule[]
  supplierItems         SupplierItem[]
  purchaseOrderLines    PurchaseOrderLine[]
  goodsReceiptLines     GoodsReceiptLine[]
  crmDealLinks          CrmDealItemLink[]
  orderLines                    OrderLine[]
  bomLinesAsPack                BomLine[]
  billsOfMaterial               BillOfMaterial[]
  productionReservationsAsPack  ProductionMaterialReservation[]
  productionConsumptions        ProductionConsumption[]

  @@unique([organizationId, itemId, code])
  @@index([organizationId, itemId, isActive])
  @@index([organizationId, packSku])
  @@map("item_pack")
}

model ItemBundleComponent {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bundleItemId       String
  bundleItem         Item         @relation("BundleParentItem", fields: [bundleItemId], references: [id], onDelete: Cascade)
  componentItemId    String
  componentItem      Item         @relation("BundleComponentItem", fields: [componentItemId], references: [id], onDelete: Restrict)
  componentPackId    String?
  componentPack      ItemPack?    @relation(fields: [componentPackId], references: [id], onDelete: SetNull)
  quantity           Int          @default(1)
  priceAllocationBps Int?
  isOptional         Boolean      @default(false)
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, bundleItemId, componentItemId])
  @@index([organizationId, bundleItemId])
  @@map("item_bundle_component")
}

model ServicePlan {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId                String
  item                  Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  description           String?
  planType              ServicePlanType   @default(HOUR_PACK)
  billingCycle          BillingCycle      @default(ONE_TIME)
  includedUnits         Int               @default(1)
  unitLabel             String            @default("hours")
  basePriceCents        Int
  overageUnitPriceCents Int?
  setupFeeCents         Int               @default(0)
  rolloverEnabled       Boolean           @default(false)
  maxRolloverUnits      Int?
  validityDays          Int?
  isActive              Boolean           @default(true)
  metadata              Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  priceRules            PriceRule[]
  crmDealLinks          CrmDealItemLink[]
  orderLines            OrderLine[]

  @@unique([organizationId, itemId, code])
  @@index([organizationId, itemId, isActive])
  @@map("service_plan")
}

model PriceBook {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  name              String
  description       String?
  direction         PriceBookDirection @default(SALES)
  currency          String             @default("USD")
  priority          Int                @default(100)
  isDefault         Boolean            @default(false)
  isActive          Boolean            @default(true)
  customerSegment   String?
  externalAccountId String?
  supplierId        String?
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  startsAt          DateTime?
  endsAt            DateTime?
  customAttributes  Json?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  rules             PriceRule[]
  crmDealLinks      CrmDealItemLink[]
  orders            Order[]

  @@unique([organizationId, code])
  @@index([organizationId, direction, isActive, priority])
  @@index([organizationId, customerSegment])
  @@index([organizationId, externalAccountId])
  @@index([organizationId, supplierId])
  @@map("price_book")
}

model PriceRule {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceBookId        String
  priceBook          PriceBook    @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  itemId             String
  item               Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  packId             String?
  pack               ItemPack?    @relation(fields: [packId], references: [id], onDelete: SetNull)
  servicePlanId      String?
  servicePlan        ServicePlan? @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  name               String
  pricingModel       PricingModel @default(FLAT)
  baseUnitPriceCents Int
  minMarginBps       Int?
  minQuantity        Int          @default(1)
  maxQuantity        Int?
  conditions         Json?
  customAdjustment   Json?
  priority           Int          @default(100)
  isActive           Boolean      @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  tiers              PriceTier[]

  @@index([organizationId, priceBookId, itemId, isActive])
  @@index([organizationId, itemId, packId])
  @@map("price_rule")
}

model PriceTier {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceRuleId       String
  priceRule         PriceRule    @relation(fields: [priceRuleId], references: [id], onDelete: Cascade)
  minQuantity       Int
  maxQuantity       Int?
  unitPriceCents    Int?
  flatFeeCents      Int?
  packageSize       Int?
  packagePriceCents Int?
  discountBps       Int?
  sortOrder         Int          @default(0)

  @@index([organizationId, priceRuleId, minQuantity])
  @@map("price_tier")
}

model DiscountRule {
  id                    String        @id @default(cuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  description           String?
  promoCode             String?
  discountType          DiscountType
  scope                 DiscountScope @default(LINE_ITEM)
  valueBps              Int?
  amountCents           Int?
  fixedPriceCents       Int?
  buyQuantity           Int?
  getQuantity           Int?
  getDiscountBps        Int?
  targetItemId          String?
  targetItem            Item?         @relation(fields: [targetItemId], references: [id], onDelete: SetNull)
  targetPackId          String?
  targetPack            ItemPack?     @relation(fields: [targetPackId], references: [id], onDelete: SetNull)
  targetTags            String[]      @default([])
  customerSegments      String[]      @default([])
  externalAccountIds    String[]      @default([])
  minQuantity           Int?
  minOrderSubtotalCents Int?
  maxDiscountCents      Int?
  isStackable           Boolean       @default(false)
  priority              Int           @default(100)
  startsAt              DateTime?
  endsAt                DateTime?
  usageLimit            Int?
  usageCount            Int           @default(0)
  isActive              Boolean       @default(true)
  conditions            Json?
  createdByUserId       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, isActive, promoCode])
  @@index([organizationId, targetItemId])
  @@map("discount_rule")
}

// ==========================================
// Customers, Orders (POS & B2B), Invoices, Cash Payments & Receipts
// ==========================================

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CustomerPoStatus {
  RECEIVED
  CONFIRMED
  PARTIALLY_INVOICED
  INVOICED
  COMPLETED
  CANCELLED
  REJECTED
}

enum OrderChannel {
  POS
  B2B
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  COMPLETED
  CANCELLED
}

enum SalesInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  MPESA
}

enum CustomerPaymentStatus {
  COMPLETED
  VOIDED
}

model Customer {
  id                   String            @id @default(cuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                 String
  type                 CustomerType      @default(INDIVIDUAL)
  status               CustomerStatus    @default(ACTIVE)
  name                 String
  companyName          String?
  email                String?
  phone                String?
  taxId                String?
  customerSegment      String?
  currency             String            @default("USD")
  paymentTermsDays     Int               @default(0)
  creditLimitCents     Int?
  creditHold           Boolean           @default(false)
  billingAddressLine1  String?
  billingAddressLine2  String?
  billingCity          String?
  billingState         String?
  billingPostalCode    String?
  billingCountry       String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingPostalCode   String?
  shippingCountry      String?
  crmProvider          CrmProvider?
  externalContactId    String?
  externalCompanyId    String?
  externalAccountId    String?
  crmLastSyncedAt      DateTime?
  notes                String?
  metadata             Json?
  createdByUserId      String?
  updatedByUserId      String?
  archivedAt           DateTime?
  archivedByUserId     String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  orders               Order[]
  invoices             SalesInvoice[]
  customerPurchaseOrders CustomerPurchaseOrder[]
  payments             CustomerPayment[]
  paymentTransactions  PaymentTransaction[]
  receipts             PaymentReceipt[]
  fulfillments         OrderFulfillment[]
  notifications        CustomerNotification[]

  @@unique([organizationId, code])
  @@index([organizationId, status, type])
  @@index([organizationId, externalContactId])
  @@index([organizationId, externalCompanyId])
  @@index([organizationId, email])
  @@map("customer")
}

model CustomerPurchaseOrder {
  id                  String             @id @default(cuid())
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  internalRef         String
  poNumber            String
  customerId          String
  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status              CustomerPoStatus   @default(RECEIVED)
  currency            String             @default("USD")
  paymentTermsDays    Int                @default(30)
  subtotalCents       Int                @default(0)
  discountTotalCents  Int                @default(0)
  taxCents            Int                @default(0)
  totalCents          Int                @default(0)
  invoicedAmountCents Int                @default(0)
  issueDate           DateTime           @default(now())
  effectiveDate       DateTime?
  expiryDate          DateTime?
  billingAddress      Json?
  shippingAddress     Json?
  notes               String?
  documentUrl         String?
  storageKey          String?
  metadata            Json?
  confirmedAt         DateTime?
  confirmedByUserId   String?
  cancelledAt         DateTime?
  cancelledByUserId   String?
  cancelReason        String?
  createdByUserId     String?
  updatedByUserId     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lines               CustomerPurchaseOrderLine[]
  orders              Order[]
  invoices            SalesInvoice[]

  @@unique([organizationId, internalRef])
  @@index([organizationId, customerId])
  @@index([organizationId, poNumber])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("customer_purchase_order")
}

model CustomerPurchaseOrderLine {
  id                      String                @id @default(cuid())
  organizationId          String
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerPurchaseOrderId String
  customerPurchaseOrder   CustomerPurchaseOrder @relation(fields: [customerPurchaseOrderId], references: [id], onDelete: Cascade)
  itemId                  String?
  item                    Item?                 @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sku                     String?
  name                    String
  description             String?
  unitOfMeasure           String                @default("unit")
  quantity                Int
  invoicedQuantity        Int                   @default(0)
  unitPriceCents          Int
  discountCents           Int                   @default(0)
  lineTotalCents          Int
  notes                   String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([organizationId, customerPurchaseOrderId])
  @@index([organizationId, itemId])
  @@map("customer_purchase_order_line")
}

model Order {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderNumber        String
  channel            OrderChannel
  status             OrderStatus       @default(DRAFT)
  locationId         String
  location           Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerPurchaseOrderId String?
  customerPurchaseOrder   CustomerPurchaseOrder? @relation(fields: [customerPurchaseOrderId], references: [id], onDelete: SetNull)
  customerPoNumber   String?
  priceBookId        String?
  priceBook          PriceBook?        @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  externalDealId     String?
  customerSegment    String?
  promoCodes         String[]          @default([])
  currency           String            @default("USD")
  subtotalCents      Int               @default(0)
  discountTotalCents Int               @default(0)
  taxCents           Int               @default(0)
  totalCents         Int               @default(0)
  paidAmountCents    Int               @default(0)
  notes              String?
  metadata           Json?
  confirmedAt        DateTime?
  confirmedByUserId  String?
  fulfilledAt        DateTime?
  fulfilledByUserId  String?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdByUserId    String?
  updatedByUserId    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lines              OrderLine[]
  invoices            SalesInvoice[]
  payments            CustomerPayment[]
  paymentTransactions PaymentTransaction[]
  receipts            PaymentReceipt[]
  fulfillment         OrderFulfillment?
  staffJobs           StaffJob[]
  notifications       CustomerNotification[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, channel, status])
  @@index([organizationId, customerId])
  @@index([organizationId, customerPurchaseOrderId])
  @@index([organizationId, locationId])
  @@index([organizationId, createdAt])
  @@map("sales_order")
}

model OrderLine {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  packId           String?
  pack             ItemPack?          @relation(fields: [packId], references: [id], onDelete: SetNull)
  servicePlanId    String?
  servicePlan      ServicePlan?       @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  sku              String
  name             String
  description      String?
  unitOfMeasure    String             @default("unit")
  unitsPerPack     Int                @default(1)
  quantity         Int
  fulfilledQty     Int                @default(0)
  orderedBaseQty   Int                @default(0)
  reservedBaseQty  Int                @default(0)
  fulfilledBaseQty Int                @default(0)
  bonusUnits       Int                @default(0)
  unitPriceCents   Int
  discountCents    Int                @default(0)
  lineTotalCents   Int
  pricingSnapshot  Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  invoiceLines     SalesInvoiceLine[]

  @@index([organizationId, orderId])
  @@index([organizationId, itemId])
  @@map("sales_order_line")
}

model SalesInvoice {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber        String
  orderId              String?
  order                Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerPurchaseOrderId String?
  customerPurchaseOrder   CustomerPurchaseOrder? @relation(fields: [customerPurchaseOrderId], references: [id], onDelete: SetNull)
  customerPoNumber     String?
  customerId           String?
  customer             Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status               SalesInvoiceStatus @default(DRAFT)
  currency             String             @default("USD")
  paymentTermsDays     Int                @default(0)
  subtotalCents        Int                @default(0)
  discountTotalCents   Int                @default(0)
  taxCents             Int                @default(0)
  totalCents           Int                @default(0)
  paidAmountCents      Int                @default(0)
  issuedAt             DateTime?
  dueAt                DateTime?
  paidAt               DateTime?
  voidedAt             DateTime?
  voidReason           String?
  notes                String?
  customerSnapshot     Json?
  organizationSnapshot Json?
  createdByUserId      String?
  updatedByUserId      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  lines                SalesInvoiceLine[]
  payments             CustomerPayment[]
  paymentTransactions  PaymentTransaction[]
  receipts             PaymentReceipt[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, orderId])
  @@index([organizationId, customerPurchaseOrderId])
  @@index([organizationId, customerId])
  @@map("sales_invoice")
}

model SalesInvoiceLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  orderLineId    String?
  orderLine      OrderLine?   @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  itemId         String?
  item           Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sku            String?
  description    String
  unitOfMeasure  String       @default("unit")
  quantity       Int
  unitPriceCents Int
  discountCents  Int          @default(0)
  lineTotalCents Int
  createdAt      DateTime     @default(now())

  @@index([organizationId, salesInvoiceId])
  @@map("sales_invoice_line")
}

model CustomerPayment {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentNumber      String
  orderId            String?
  order              Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  salesInvoiceId     String?
  salesInvoice       SalesInvoice?         @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  customerId         String?
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  method             PaymentMethod         @default(CASH)
  status             CustomerPaymentStatus @default(COMPLETED)
  currency           String                @default("USD")
  amountAppliedCents Int
  cashTenderedCents  Int
  changeGivenCents   Int                   @default(0)
  reference          String?
  notes              String?
  receivedByUserId   String?
  receivedAt         DateTime              @default(now())
  voidedAt           DateTime?
  voidReason         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  receipt            PaymentReceipt?
  paymentTransaction PaymentTransaction?

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, orderId])
  @@index([organizationId, salesInvoiceId])
  @@index([organizationId, customerId])
  @@map("customer_payment")
}

model PaymentReceipt {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptNumber     String
  paymentId         String          @unique
  payment           CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  salesInvoiceId    String?
  salesInvoice      SalesInvoice?   @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel           OrderChannel    @default(B2B)
  currency          String          @default("USD")
  totalCents        Int
  cashTenderedCents Int
  changeGivenCents  Int             @default(0)
  snapshot          Json
  issuedAt          DateTime        @default(now())
  issuedByUserId    String?
  createdAt         DateTime        @default(now())

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, orderId])
  @@index([organizationId, customerId])
  @@index([organizationId, issuedAt])
  @@map("payment_receipt")
}

// ==========================================
// Order Fulfillment (Preorders, Pickups, Deliveries), Staff Jobs & Notifications
// ==========================================

enum FulfillmentType {
  PREORDER
  PICKUP
  DELIVERY
}

enum FulfillmentStatus {
  PENDING
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum DeliveryStage {
  NONE
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PreorderDepositStatus {
  NOT_REQUIRED
  UNPAID
  DEPOSIT_PAID
  PAID
}

enum StaffJobStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommunicationChannel {
  SMS
  WHATSAPP
  EMAIL
  WEBHOOK
  IN_APP
}

enum NotificationEventType {
  PREORDER_READY
  JOB_COMPLETED
  DELIVERY_OUT_FOR_DELIVERY
  DELIVERY_DELIVERED
  CUSTOM
}

enum NotificationDeliveryStatus {
  SENT
  SANDBOX
  FALLBACK_SENT
  SKIPPED_DISABLED
  FAILED
}

model FulfillmentSettings {
  id                           String               @id @default(cuid())
  organizationId               String               @unique
  organization                 Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  autoConvertPreordersToJobs   Boolean              @default(false)
  defaultJobLeadMinutes        Int                  @default(120)
  defaultJobAssigneeStaffId    String?
  defaultJobAssigneeRole       String?
  syncJobsToCrm                Boolean              @default(false)
  defaultChannel               CommunicationChannel @default(SMS)
  autoNotifyOnPreorderReady    Boolean              @default(true)
  autoNotifyOnJobCompleted     Boolean              @default(true)
  autoNotifyOnDeliveryUpdates  Boolean              @default(true)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  @@map("fulfillment_settings")
}

model OrderFulfillment {
  id                         String                 @id @default(cuid())
  organizationId             String
  organization               Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fulfillmentNumber          String
  orderId                    String                 @unique
  order                      Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  locationId                 String
  location                   Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customerId                 String?
  customer                   Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  type                       FulfillmentType
  status                     FulfillmentStatus      @default(PENDING)
  deliveryStage              DeliveryStage          @default(NONE)
  stockReserved              Boolean                @default(false)
  stockDeducted              Boolean                @default(false)
  scheduledFulfillmentAt     DateTime?
  depositRequiredCents       Int                    @default(0)
  depositStatus              PreorderDepositStatus  @default(NOT_REQUIRED)
  preparationNotes           String?
  autoConvertToJob           Boolean?
  pickupWindowStart          DateTime?
  pickupWindowEnd            DateTime?
  pickupInstructions         String?
  handoffConfirmedAt         DateTime?
  handoffConfirmedByUserId   String?
  deliveryAddressLine1       String?
  deliveryAddressLine2       String?
  deliveryCity               String?
  deliveryState              String?
  deliveryPostalCode         String?
  deliveryCountry            String?
  deliveryInstructions       String?
  deliveryWindowStart        DateTime?
  deliveryWindowEnd          DateTime?
  courierStaffId             String?
  courierStaff               StaffProfile?          @relation("FulfillmentCourier", fields: [courierStaffId], references: [id], onDelete: SetNull)
  courierName                String?
  courierPhone               String?
  outForDeliveryAt           DateTime?
  deliveredAt                DateTime?
  notificationsEnabled       Boolean                @default(true)
  preferredChannel           CommunicationChannel?
  notifyOnPreorderReady      Boolean                @default(true)
  notifyOnJobCompleted       Boolean                @default(true)
  notifyOnDeliveryUpdates    Boolean                @default(true)
  confirmedAt                DateTime?
  confirmedByUserId          String?
  readyAt                    DateTime?
  completedAt                DateTime?
  completedByUserId          String?
  cancelledAt                DateTime?
  cancelReason               String?
  metadata                   Json?
  createdByUserId            String?
  updatedByUserId            String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  staffJobs                  StaffJob[]
  notifications              CustomerNotification[]
  paymentTransactions        PaymentTransaction[]

  @@unique([organizationId, fulfillmentNumber])
  @@index([organizationId, type, status])
  @@index([organizationId, customerId])
  @@index([organizationId, locationId])
  @@index([organizationId, scheduledFulfillmentAt])
  @@map("order_fulfillment")
}

model StaffJob {
  id                   String                 @id @default(cuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobNumber            String
  fulfillmentId        String
  fulfillment          OrderFulfillment       @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderId              String
  order                Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title                String
  instructions         String?
  status               StaffJobStatus         @default(ASSIGNED)
  priority             Int                    @default(2)
  assignedStaffId      String?
  assignedStaff        StaffProfile?          @relation("StaffJobAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedDepartmentId String?
  assignedDepartment   Department?            @relation(fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  assignedTeamId       String?
  assignedTeam         Team?                  @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  assignedRole         String?
  targetDueAt          DateTime?
  startedAt            DateTime?
  startedByUserId      String?
  completedAt          DateTime?
  completedByUserId    String?
  cancelledAt          DateTime?
  syncToCrm            Boolean                @default(false)
  externalTaskId       String?
  crmSyncedAt          DateTime?
  metadata             Json?
  createdByUserId      String?
  updatedByUserId      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  notifications        CustomerNotification[]

  @@unique([organizationId, jobNumber])
  @@index([organizationId, fulfillmentId, status])
  @@index([organizationId, assignedStaffId, status])
  @@index([organizationId, targetDueAt])
  @@map("staff_job")
}

model NotificationTemplate {
  id              String                @id @default(cuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType       NotificationEventType
  channel         CommunicationChannel
  name            String
  subject         String?
  body            String
  isActive        Boolean               @default(true)
  updatedByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([organizationId, eventType, channel])
  @@index([organizationId, eventType])
  @@map("notification_template")
}

model CustomerNotification {
  id                String                     @id @default(cuid())
  organizationId    String
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fulfillmentId     String
  fulfillment       OrderFulfillment           @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffJobId        String?
  staffJob          StaffJob?                  @relation(fields: [staffJobId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  eventType         NotificationEventType
  channel           CommunicationChannel
  triggerSource     String                     @default("AUTO")
  recipient         String?
  subject           String?
  message           String
  status            NotificationDeliveryStatus
  provider          String?
  externalMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  sentByUserId      String?
  createdAt         DateTime                   @default(now())

  @@index([organizationId, fulfillmentId, createdAt])
  @@index([organizationId, orderId])
  @@index([organizationId, customerId])
  @@map("customer_notification")
}

// ==========================================
// Enterprise OAuth2, PAT, Devices & SSO
// ==========================================

enum OAuthClientType {
  PUBLIC_PKCE
  CONFIDENTIAL
  M2M_SERVICE
  DEVICE_TERMINAL
}

enum OAuthAppCategory {
  ANDROID_MOBILE
  POS_TERMINAL
  PRODUCTION_SYSTEM
  ERP_INTEGRATION
  WEB_APP
  OTHER
}

enum OAuthClientStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum OAuthSigningAlgorithm {
  RS256
  ES256
  EDDSA
}

enum OAuthDeviceCodeStatus {
  PENDING
  APPROVED
  DENIED
  CONSUMED
  EXPIRED
}

enum RegisteredDeviceType {
  ANDROID
  POS_TERMINAL
  PRODUCTION_KIOSK
  SCANNER
  SYSTEM_AGENT
}

enum RegisteredDeviceStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum SsoProviderType {
  GOOGLE
  MICROSOFT_ENTRA
  OKTA
  OIDC
}

model AuthSigningKey {
  id                     String                @id @default(cuid())
  kid                    String                @unique
  algorithm              OAuthSigningAlgorithm @default(ES256)
  publicJwk              Json
  encryptedPrivateKeyPem String
  isPrimary              Boolean               @default(false)
  isActive               Boolean               @default(true)
  expiresAt              DateTime?
  createdAt              DateTime              @default(now())

  @@index([isActive, isPrimary])
  @@map("auth_signing_key")
}

model OAuthClient {
  id                     String                   @id @default(cuid())
  organizationId         String
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId               String                   @unique
  name                   String
  description            String?
  clientType             OAuthClientType
  appCategory            OAuthAppCategory         @default(OTHER)
  status                 OAuthClientStatus        @default(ACTIVE)
  clientSecretHash       String?
  clientSecretLast4      String?
  authMethods            String[]                 @default(["client_secret_basic"])
  allowedGrantTypes      String[]                 @default(["client_credentials"])
  redirectUris           String[]                 @default([])
  allowedScopes          String[]                 @default([])
  serviceRole            String                   @default("member")
  locationId             String?
  location               Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ipAllowlist            String[]                 @default([])
  jwksUri                String?
  isFirstParty           Boolean                  @default(false)
  requireConsent         Boolean                  @default(true)
  accessTokenTtlSeconds  Int                      @default(900)
  refreshTokenTtlSeconds Int                      @default(2592000)
  createdByUserId        String?
  revokedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  keys                   OAuthClientKey[]
  authorizationCodes     OAuthAuthorizationCode[]
  deviceCodes            OAuthDeviceCode[]
  refreshTokens          OAuthRefreshToken[]
  registeredDevices      RegisteredDevice[]

  @@index([organizationId, status])
  @@index([organizationId, appCategory])
  @@map("oauth_client")
}

model OAuthClientKey {
  id              String                @id @default(cuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthClientId   String
  oauthClient     OAuthClient           @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  kid             String
  name            String
  algorithm       OAuthSigningAlgorithm @default(ES256)
  publicKeyPem    String
  publicJwk       Json
  isActive        Boolean               @default(true)
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime              @default(now())

  @@unique([oauthClientId, kid])
  @@index([organizationId, oauthClientId, isActive])
  @@map("oauth_client_key")
}

model OAuthAuthorizationCode {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthClientId       String
  oauthClient         OAuthClient  @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash            String       @unique
  redirectUri         String
  scopes              String[]     @default([])
  codeChallenge       String
  codeChallengeMethod String       @default("S256")
  nonce               String?
  deviceIdentifier    String?
  deviceName          String?
  deviceOsVersion     String?
  deviceAppVersion    String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime     @default(now())

  @@index([organizationId, oauthClientId])
  @@index([expiresAt])
  @@map("oauth_authorization_code")
}

model OAuthDeviceCode {
  id               String                @id @default(cuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthClientId    String
  oauthClient      OAuthClient           @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  locationId       String?
  location         Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  deviceCodeHash   String                @unique
  userCode         String                @unique
  scopes           String[]              @default([])
  status           OAuthDeviceCodeStatus @default(PENDING)
  deviceName       String?
  deviceIdentifier String?
  deviceType       RegisteredDeviceType  @default(POS_TERMINAL)
  approvedByUserId String?
  approvedAt       DateTime?
  deniedByUserId   String?
  deniedAt         DateTime?
  intervalSeconds  Int                   @default(5)
  lastPolledAt     DateTime?
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime              @default(now())

  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("oauth_device_code")
}

model OAuthRefreshToken {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthClientId      String
  oauthClient        OAuthClient       @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredDeviceId String?
  registeredDevice   RegisteredDevice? @relation(fields: [registeredDeviceId], references: [id], onDelete: SetNull)
  familyId           String
  tokenHash          String            @unique
  scopes             String[]          @default([])
  expiresAt          DateTime
  revokedAt          DateTime?
  revocationReason   String?
  replacedById       String?
  createdAt          DateTime          @default(now())

  @@index([organizationId, familyId])
  @@index([organizationId, userId])
  @@index([registeredDeviceId])
  @@map("oauth_refresh_token")
}

model PersonalAccessToken {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  tokenPrefix     String       @unique
  tokenHash       String       @unique
  scopes          String[]     @default([])
  ipAllowlist     String[]     @default([])
  lastUsedAt      DateTime?
  lastUsedIp      String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, userId])
  @@index([organizationId, revokedAt])
  @@map("personal_access_token")
}

model RegisteredDevice {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthClientId    String?
  oauthClient      OAuthClient?           @relation(fields: [oauthClientId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  locationId       String?
  location         Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  deviceType       RegisteredDeviceType
  deviceIdentifier String
  name             String
  osVersion        String?
  appVersion       String?
  status           RegisteredDeviceStatus @default(ACTIVE)
  trusted          Boolean                @default(true)
  ipAllowlist      String[]               @default([])
  lastSeenAt       DateTime?
  lastIp           String?
  revokedAt        DateTime?
  revokedByUserId  String?
  revokeReason     String?
  metadata         Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  refreshTokens    OAuthRefreshToken[]

  @@unique([organizationId, deviceIdentifier, deviceType])
  @@index([organizationId, deviceType, status])
  @@index([organizationId, userId])
  @@map("registered_device")
}

model OrganizationSsoProvider {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerKey           String
  providerType          SsoProviderType
  displayName           String
  issuerUrl             String?
  authorizationEndpoint String?
  tokenEndpoint         String?
  userinfoEndpoint      String?
  jwksUri               String?
  clientId              String
  encryptedClientSecret String?
  clientSecretLast4     String?
  scopes                String[]        @default(["openid", "profile", "email"])
  allowedDomains        String[]        @default([])
  autoProvisionRole     String          @default("member")
  enforceSsoOnly        Boolean         @default(false)
  enabled               Boolean         @default(true)
  createdByUserId       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([organizationId, providerKey])
  @@index([organizationId, enabled])
  @@map("organization_sso_provider")
}

// ==========================================
// Enterprise Manufacturing & Production Lifecycle Models
// ==========================================

enum WorkCenterStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
  ARCHIVED
}

enum OverheadAllocationType {
  FIXED_PER_HOUR
  PERCENT_OF_LABOR
  PER_UNIT
}

enum BomStatus {
  DRAFT
  ACTIVE
  REVISED
  OBSOLETE
}

enum BomIssueMethod {
  MANUAL
  BACKFLUSH
}

enum SubAssemblyStrategy {
  MAKE_TO_STOCK
  CONSUME_STOCK_ONLY
  CONSUME_STOCK_OR_EXPLODE
  ALWAYS_EXPLODE
}

enum RoutingStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OBSOLETE
}

enum ProductionBatchStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  QC_HOLD
  COMPLETED
  CLOSED
  CANCELLED
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProductionQcStatus {
  NOT_REQUIRED
  PENDING
  PASSED
  FAILED
  WAIVED
}

enum ProductionOperationStatus {
  PENDING
  SCHEDULED
  READY
  IN_PROGRESS
  PAUSED
  QC_PENDING
  COMPLETED
  SKIPPED
  CANCELLED
}

enum ProductionQcCheckpointType {
  IN_PROCESS
  FINAL_RELEASE
}

enum ProductionQcCheckpointStatus {
  PENDING
  PASSED
  FAILED
  WAIVED
}

enum ProductionCostCategory {
  MATERIAL
  LABOR
  MACHINE
  OVERHEAD
  SCRAP
  ADJUSTMENT
}

model WorkCenter {
  id                     String                 @id @default(cuid())
  organizationId         String
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId             String
  location               Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  code                   String
  name                   String
  description            String?
  status                 WorkCenterStatus       @default(ACTIVE)
  dailyCapacityMinutes   Int                    @default(480)
  hourlyLaborRateCents   Int                    @default(0)
  hourlyMachineRateCents Int                    @default(0)
  overheadRateCents      Int                    @default(0)
  overheadType           OverheadAllocationType @default(FIXED_PER_HOUR)
  isActive               Boolean                @default(true)
  metadata               Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  routingOperations      RoutingOperation[]
  productionOperations   ProductionOperation[]
  timeLogs               ProductionTimeLog[]

  @@unique([organizationId, code])
  @@index([organizationId, locationId, status])
  @@map("work_center")
}

model BillOfMaterial {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId                String
  item                  Item              @relation("FinishedItemBoms", fields: [itemId], references: [id], onDelete: Cascade)
  packId                String?
  pack                  ItemPack?         @relation(fields: [packId], references: [id], onDelete: SetNull)
  code                  String
  name                  String
  description           String?
  version               Int               @default(1)
  yieldQty              Int               @default(1)
  status                BomStatus         @default(DRAFT)
  isDefault             Boolean           @default(false)
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  standardOverheadCents Int               @default(0)
  notes                 String?
  createdByUserId       String?
  approvedByUserId      String?
  approvedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  lines                 BomLine[]
  productionBatches     ProductionBatch[]

  @@unique([organizationId, code])
  @@index([organizationId, itemId, status])
  @@map("bill_of_material")
}

model BomLine {
  id                  String              @id @default(cuid())
  organizationId      String
  bomId               String
  billOfMaterial      BillOfMaterial      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  lineNumber          Int                 @default(1)
  componentItemId     String
  componentItem       Item                @relation("ComponentItemBomLines", fields: [componentItemId], references: [id], onDelete: Restrict)
  packId              String?
  pack                ItemPack?           @relation(fields: [packId], references: [id], onDelete: SetNull)
  unitsPerPack        Int                 @default(1)
  quantity            Int                 @default(1)
  baseQuantity        Int                 @default(1)
  scrapBps            Int                 @default(0)
  issueMethod         BomIssueMethod      @default(MANUAL)
  subAssemblyStrategy SubAssemblyStrategy @default(CONSUME_STOCK_OR_EXPLODE)
  operationSequence   Int?
  isOptional          Boolean             @default(false)
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([organizationId, bomId])
  @@index([organizationId, componentItemId])
  @@map("bom_line")
}

model Routing {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId            String?
  item              Item?              @relation(fields: [itemId], references: [id], onDelete: SetNull)
  code              String
  name              String
  description       String?
  version           Int                @default(1)
  status            RoutingStatus      @default(DRAFT)
  isDefault         Boolean            @default(false)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  notes             String?
  createdByUserId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  operations        RoutingOperation[]
  productionBatches ProductionBatch[]

  @@unique([organizationId, code])
  @@index([organizationId, itemId, status])
  @@map("routing")
}

model RoutingOperation {
  id                   String                @id @default(cuid())
  organizationId       String
  routingId            String
  routing              Routing               @relation(fields: [routingId], references: [id], onDelete: Cascade)
  workCenterId         String
  workCenter           WorkCenter            @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  sequence             Int
  operationCode        String
  name                 String
  setupMinutes         Int                   @default(0)
  runMinutesPerUnit    Float                 @default(0)
  requiresQcGate       Boolean               @default(false)
  qcChecklistTemplate  Json?
  instructions         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  productionOperations ProductionOperation[]

  @@unique([routingId, sequence])
  @@index([organizationId, routingId])
  @@index([organizationId, workCenterId])
  @@map("routing_operation")
}

model ProductionBatch {
  id                        String                          @id @default(cuid())
  organizationId            String
  organization              Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchNumber               String
  name                      String?
  locationId                String
  location                  Location                        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  outputItemId              String?
  outputItem                Item?                           @relation("BatchFinishedItem", fields: [outputItemId], references: [id], onDelete: Restrict)
  bomId                     String?
  bom                       BillOfMaterial?                 @relation(fields: [bomId], references: [id], onDelete: SetNull)
  routingId                 String?
  routing                   Routing?                        @relation(fields: [routingId], references: [id], onDelete: SetNull)
  parentBatchId             String?
  parentBatch               ProductionBatch?                @relation("SubAssemblyBatches", fields: [parentBatchId], references: [id], onDelete: SetNull)
  childBatches              ProductionBatch[]               @relation("SubAssemblyBatches")
  status                    ProductionBatchStatus           @default(PLANNED)
  priority                  ProductionPriority              @default(NORMAL)
  qcStatus                  ProductionQcStatus              @default(NOT_REQUIRED)
  plannedOutputQty          Int                             @default(1)
  actualOutputQty           Int                             @default(0)
  scrapQty                  Int                             @default(0)
  outputLotId               String?
  outputLot                 StockLot?                       @relation("OutputStockLot", fields: [outputLotId], references: [id], onDelete: SetNull)
  scheduledStartAt          DateTime?
  scheduledEndAt            DateTime?
  releasedAt                DateTime?
  releasedByUserId          String?
  startedAt                 DateTime?
  completedAt               DateTime?
  closedAt                  DateTime?
  cancelledAt               DateTime?
  requiresFinalQcRelease    Boolean                         @default(false)
  qcReleasedAt              DateTime?
  qcReleasedByUserId        String?
  standardMaterialCostCents Int                             @default(0)
  standardLaborCostCents    Int                             @default(0)
  standardMachineCostCents  Int                             @default(0)
  standardOverheadCostCents Int                             @default(0)
  standardTotalCostCents    Int                             @default(0)
  actualMaterialCostCents   Int                             @default(0)
  actualLaborCostCents      Int                             @default(0)
  actualMachineCostCents    Int                             @default(0)
  actualOverheadCostCents   Int                             @default(0)
  actualScrapCostCents      Int                             @default(0)
  actualTotalCostCents      Int                             @default(0)
  costVarianceCents         Int                             @default(0)
  notes                     String?
  metadata                  Json?
  createdByUserId           String?
  updatedByUserId           String?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  operations                ProductionOperation[]
  reservations              ProductionMaterialReservation[]
  consumptions              ProductionConsumption[]
  qcCheckpoints             ProductionQcCheckpoint[]
  costEntries               ProductionCostEntry[]
  documentAttachments       DocumentAttachment[]
  timeLogs                  ProductionTimeLog[]

  @@unique([organizationId, batchNumber])
  @@index([organizationId, status, priority])
  @@index([organizationId, locationId])
  @@index([organizationId, outputItemId])
  @@map("production_batch")
}

model ProductionMaterialReservation {
  id                  String                @id @default(cuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionBatchId   String
  productionBatch     ProductionBatch       @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  bomLineId           String?
  itemId              String
  item                Item                  @relation("ReservationItem", fields: [itemId], references: [id], onDelete: Restrict)
  packId              String?
  pack                ItemPack?             @relation(fields: [packId], references: [id], onDelete: SetNull)
  locationId          String
  location            Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  stockLotId          String?
  stockLot            StockLot?             @relation(fields: [stockLotId], references: [id], onDelete: SetNull)
  routingOperationId  String?
  unitsPerPack        Int                   @default(1)
  requiredBaseQty     Int
  scrapAllowanceQty   Int                   @default(0)
  reservedBaseQty     Int                   @default(0)
  issuedBaseQty       Int                   @default(0)
  issueMethod         BomIssueMethod        @default(MANUAL)
  subAssemblyStrategy SubAssemblyStrategy   @default(CONSUME_STOCK_OR_EXPLODE)
  allocationStrategy  LotAllocationStrategy @default(FEFO)
  operationSequence   Int?
  isReleased          Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([organizationId, productionBatchId])
  @@index([organizationId, itemId, locationId])
  @@map("production_material_reservation")
}

model ProductionOperation {
  id                    String                    @id @default(cuid())
  organizationId        String
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionBatchId     String
  productionBatch       ProductionBatch           @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  routingOperationId    String?
