  variantAttributes    ItemVariantAttribute[]

  @@unique([organizationId, optionId, code])
  @@index([organizationId, optionId, sortOrder])
  @@map("variant_option_value")
}

model ItemTemplateOption {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateItemId String
  templateItem   Item                      @relation("TemplateItemOptions", fields: [templateItemId], references: [id], onDelete: Cascade)
  optionId       String
  option         VariantOption             @relation(fields: [optionId], references: [id], onDelete: Restrict)
  sortOrder      Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  allowedValues  ItemTemplateOptionValue[]

  @@unique([organizationId, templateItemId, optionId])
  @@index([organizationId, templateItemId, sortOrder])
  @@map("item_template_option")
}

model ItemTemplateOptionValue {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateOptionId String
  templateOption   ItemTemplateOption @relation(fields: [templateOptionId], references: [id], onDelete: Cascade)
  optionValueId    String
  optionValue      VariantOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())

  @@unique([organizationId, templateOptionId, optionValueId])
  @@index([organizationId, templateOptionId, sortOrder])
  @@map("item_template_option_value")
}

model ItemVariantAttribute {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variantItemId  String
  variantItem    Item               @relation("VariantItemAttributes", fields: [variantItemId], references: [id], onDelete: Cascade)
  optionId       String
  option         VariantOption      @relation(fields: [optionId], references: [id], onDelete: Restrict)
  optionValueId  String
  optionValue    VariantOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())

  @@unique([organizationId, variantItemId, optionId])
  @@index([organizationId, optionId, optionValueId])
  @@index([organizationId, variantItemId])
  @@map("item_variant_attribute")
}

// ==========================================
