  webhookIds      String[]               @default([])
  cooldownMinutes Int                    @default(1440)
  lastTriggeredAt DateTime?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([organizationId, eventType, isActive])
  @@map("alert_rule")
}

model CommunicationWebhook {
  id                     String                   @id @default(cuid())
  organizationId         String
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  url                    String
  eventTypes             CommunicationEventType[] @default([])
  signingSecretEncrypted String
  signingSecretHint      String
  isActive               Boolean                  @default(true)
  failureCount           Int                      @default(0)
  lastSuccessAt          DateTime?
  lastFailureAt          DateTime?
  lastError              String?
  createdByUserId        String?
  updatedByUserId        String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([organizationId, isActive])
  @@map("communication_webhook")
}

model CommunicationOutboxEvent {
  id                   String                        @id @default(cuid())
  organizationId       String
  organization         Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType            CommunicationEventType
  severity             AlertSeverity                 @default(INFO)
  sourceEntityType     String?
  sourceEntityId       String?
  dedupeKey            String?
  channelHints         CommunicationChannel[]        @default([])
  targetRoles          String[]                      @default([])
  targetEmails         String[]                      @default([])
  targetWebhookIds     String[]                      @default([])
  subject              String
  summaryText          String
  payload              Json
  deliveryStatus       OutboxDeliveryStatus          @default(PENDING)
  attemptCount         Int                           @default(0)
  maxAttempts          Int                           @default(5)
  nextRetryAt          DateTime?
  lockedUntil          DateTime?
  lockedBy             String?
  dispatchedAt         DateTime?
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  lastError            String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  deliveryAttempts     CommunicationDeliveryAttempt[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, deliveryStatus, nextRetryAt])
  @@index([deliveryStatus, nextRetryAt])
  @@index([organizationId, eventType, createdAt])
  @@map("communication_outbox_event")
}

model CommunicationDeliveryAttempt {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outboxEventId     String
  outboxEvent       CommunicationOutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  channel           CommunicationChannel
  target            String
  status            String
  httpStatus        Int?
  providerMessageId String?
  errorMessage      String?
  attemptedAt       DateTime                 @default(now())

  @@index([organizationId, outboxEventId, attemptedAt])
  @@map("communication_delivery_attempt")
}

