model CrmDealItemLink {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalDealId    String
  itemId            String
  item              Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  packId            String?
  pack              ItemPack?    @relation(fields: [packId], references: [id], onDelete: SetNull)
  servicePlanId     String?
  servicePlan       ServicePlan? @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  priceBookId       String?
  priceBook         PriceBook?   @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  promoCode         String?
  externalServiceId String?
  quantity          Int          @default(1)
  unitPriceCents    Int
  baseSubtotalCents Int?
  discountCents     Int          @default(0)
  currency          String       @default("USD")
  appliedPricing    Json?
  notes             String?
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

