{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@scace/typescript-config/library.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "rootDir": "src",
    "outDir": "dist/cjs",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "composite": false,
    "incremental": false,
    "tsBuildInfoFile": "tsconfig.cjs.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
